{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_provenance.schema.json",
  "title": "Latent Study Artifact Provenance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_schema_version",
    "artifact_type",
    "artifact_sha256",
    "dependencies",
    "repository_commit",
    "source_tree_hash",
    "protocol_config_hash",
    "resolved_config_hash",
    "model_id",
    "model_revision",
    "corpus_hash",
    "tool_schema_hash",
    "command",
    "cli_overrides"
  ],
  "properties": {
    "artifact_schema_version": {"const": 3},
    "artifact_type": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "path", "path_base", "hash_kind", "artifact_type", "artifact_sha256", "provenance_identity"], "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}, "path_base": {"enum": ["artifact", "repository"]}, "hash_kind": {"enum": ["artifact_content", "corpus_snapshot", "evaluation_dataset_snapshot"]}, "artifact_type": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_identity": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "repository_commit": {"type": "string", "minLength": 1},
    "source_tree_hash": {"type": "string", "minLength": 1},
    "protocol_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_config_hash": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "corpus_hash": {"type": "string", "minLength": 1},
    "tool_schema_hash": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "cli_overrides": {"type": "object"},
    "tokenizer_id": {"type": ["string", "null"]},
    "tokenizer_revision": {"type": ["string", "null"]}
  }
}
