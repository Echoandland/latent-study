{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Latent Study Corpus Manifest",
  "type": "object",
  "required": ["schema_version", "corpus_hash", "documents", "units", "excluded", "counts",
               "verified_relations", "relation_audit"],
  "properties": {
    "schema_version": {"const": 2},
    "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {"type": "array"},
    "units": {"type": "array"},
    "excluded": {"type": "array"},
    "verified_relations": {"type": "array"},
    "relation_audit": {"type": "object",
      "required": ["syntactic", "uniquely_verified", "ambiguous", "excluded", "excluded_by_reason"]},
    "counts": {"type": "object"}
  }
}
