{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Latent Study Record",
  "type": "object",
  "required": ["record_id", "family", "source_id", "prompt", "observation", "evidence_groups",
               "positive_chunk_ids", "verified_negative_chunk_ids", "candidate_actions", "outcomes",
               "validation", "corpus_hash", "source_hash", "template_id", "random_seed", "weak_label"],
  "properties": {
    "record_id": {"type": "string"},
    "family": {"enum": ["comprehension", "relation_induction", "navigation", "evidence_interpretation", "misconception_correction"]},
    "evidence_groups": {"type": "array", "minItems": 1},
    "candidate_actions": {"type": "array", "minItems": 1},
    "outcomes": {"type": "array", "minItems": 1},
    "weak_label": {"type": "boolean"}
  }
}
